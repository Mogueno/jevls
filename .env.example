# TypeSafe Jev API Key (required for code analysis)
# Obtain your key from TypeSafe (https://typesafe.ai)
TYPESAFE_API_KEY=

# (Optional) PostgreSQL Database URL (e.g. Neon, Supabase, RDS)
# When omitted, an embedded in-memory PGLite database is used automatically for dev/preview.
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
